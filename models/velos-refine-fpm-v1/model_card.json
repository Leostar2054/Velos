{
  "name": "velos-refine-fpm",
  "version": "1.0.0",
  "created": "2026-11-25",
  "task": "refinement of LED-array Fourier ptychographic (FPM) reconstructions from reduced LED sets",
  "architecture": {
    "type": "RefineUNet (residual U-Net, GroupNorm, SiLU)",
    "base_channels": 32,
    "depth": 4,
    "parameters": 7766018
  },
  "inputs": "x float32 [1, 3, T, T] = (Re, Im, mask) of the FLATTENED, NORMALISED EPRY object (point-source curvature, tilt and mean phase removed: velos_recon.fpm.apply_flatten; then velos_recon.normalise.normalise)",
  "outputs": "y float32 [1, 2, T, T] = (Re, Im) of the refined object in the same frame",
  "normalisation": "median_ramp",
  "normalisation_details": "remove linear phase ramp (median wrapped gradients), divide by median amplitude and circular-median phase over the coverage mask; velos_recon.normalise.normalise / denormalise",
  "tile": 256,
  "tile_overlap": 64,
