# Production / staging environment for docker-compose.prod.yml. Copy to deploy/.env on the server
# (never commit the real file). All values below are placeholders.
SITE_DOMAIN=velos.example.com
ACME_EMAIL=ops@velos.example.com
# API keys: comma list of key:name:role. Generate keys with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
VELOS_API_KEYS=REPLACE_WITH_RANDOM_KEY:lab:user,REPLACE_WITH_ANOTHER_RANDOM_KEY:admin:admin
VELOS_MAX_UPLOAD_MB=2048
VELOS_DEFAULT_MODEL=velos-refine-v2
VELOS_LOG_LEVEL=INFO
# image tag deployed (CI publishes velos-backend:<tag>, velos-edge:<tag>)
VELOS_TAG=0.3.0
