# Velos edge server (production / staging): HTTPS (automatic certificates), the static website,
# and a reverse proxy to the API. Environment:
#   SITE_DOMAIN   e.g. velosbioimaging.com  (":8080" for a plain-HTTP local rehearsal)
#   ACME_EMAIL    contact address for the certificate authority (Velos-owned mailbox)
#   API_UPSTREAM  default api:8000 (the compose service)
#   WEB_ROOT      default /srv/www (static export baked into the image)
{
	email {$ACME_EMAIL:admin@localhost}
}

{$SITE_DOMAIN:localhost} {
	encode zstd gzip

	# metrics stay inside the compose network (Prometheus scrapes api:8000/metrics directly)
	@metrics path /metrics /metrics/*
	handle @metrics {
		respond 404
	}

	@api path /api/* /health /docs /docs/* /redoc /openapi.json
	handle @api {
		request_body {
			max_size 2GB
		}
		reverse_proxy {$API_UPSTREAM:api:8000} {
			transport http {
				read_timeout 15m
				write_timeout 15m
			}
		}
	}

	handle {
		root * {$WEB_ROOT:/srv/www}
		try_files {path} {path}/index.html {path}.html
		file_server
		header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	log {
		output stdout
		format json
	}
}
