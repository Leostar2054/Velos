{
  "openapi": "3.1.0",
  "info": {
    "title": "Velos BioImaging Reconstruction API",
    "description": "Upload ptychographic microscopy data, run SPARK physics-based (and ML-refined) reconstructions asynchronously, and retrieve amplitude/phase results.",
    "version": "0.2.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/contact": {
      "get": {
        "tags": [
          "website"
        ],
        "summary": "List Contacts",
        "operationId": "list_contacts_api_v1_contact_get",
        "responses": {
          "200": {
            "description": "Successful Response",
