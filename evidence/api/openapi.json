  },
  "components": {
    "schemas": {
      "Body_upload_dataset_api_v1_datasets_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_dataset_api_v1_datasets_post"
      },
      "ContactIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "maxLength": 200,
            "minLength": 3,
            "title": "Email"
          },
          "organisation": {
            "type": "string",
            "maxLength": 200,
            "title": "Organisation",
            "default": ""
          },
          "message": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message"
          },
          "website": {
            "type": "string",
            "title": "Website",
            "description": "honeypot: must stay empty",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "name",
          "email",
          "message"
        ],
        "title": "ContactIn"
      },
      "DatasetOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "owner": {
            "type": "string",
            "title": "Owner"
          },
          "summary": {
            "additionalProperties": true,
            "type": "object",
            "title": "Summary"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "filename",
          "size_bytes",
          "owner",
          "summary",
          "created_at"
        ],
        "title": "DatasetOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobCreate": {
        "properties": {
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id"
          },
          "engine": {
            "type": "string",
            "title": "Engine",
            "description": "epie | rpie | wasp | gd | map",
            "default": "epie"
          },
          "iters": {
            "type": "integer",
            "maximum": 5000.0,
            "minimum": 1.0,
            "title": "Iters",
            "default": 100
          },
          "seed": {
            "type": "integer",
            "title": "Seed",
            "default": 0
          },
          "crop": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 32.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Crop",
            "description": "centre-crop frames to N px (fast preview)"
          },
          "sparse_every": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Sparse Every",
            "description": "keep every k-th grid row/col (sparse-scan test)",
            "default": 1
          },
          "engine_params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Engine Params"
          },
          "refine_ml": {
            "type": "boolean",
            "title": "Refine Ml",
            "description": "apply the ML refinement model after reconstruction",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "dataset_id"
        ],
        "title": "JobCreate"
      },
      "JobOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id"
          },
          "owner": {
            "type": "string",
            "title": "Owner"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params"
          },
          "progress": {
            "type": "number",
            "title": "Progress"
          },
          "iteration": {
            "type": "integer",
            "title": "Iteration"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "error": {
            "type": "string",
            "title": "Error"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "links": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Links"
          }
        },
        "type": "object",
        "required": [
          "id",
          "dataset_id",
          "owner",
          "status",
          "params",
          "progress",
          "iteration",
          "message",
          "error",
          "created_at",
          "started_at",
          "finished_at"
        ],
        "title": "JobOut"
      },
      "JobResultOut": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "summary": {
            "additionalProperties": true,
            "type": "object",
            "title": "Summary"
          },
          "artifacts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Artifacts"
          },
          "links": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Links"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "summary",
          "artifacts",
          "links"
        ],
        "title": "JobResultOut"
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "cancelling",
          "cancelled"
        ],
        "title": "JobStatus"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}